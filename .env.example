# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Neon Console → your project → Connection Details → "Pooled connection".
# Must include ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/mudkraft?sslmode=require"

# --- Auth (Better Auth) ----------------------------------------------------
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Absolute base URL of this app. In production use the real domain.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth ----------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google      (development)
#   https://your-domain.com/api/auth/callback/google    (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Same value as GOOGLE_CLIENT_ID above, repeated so the browser can read it.
# Required for the Google One Tap "Continue as …" prompt; without it One Tap is
# silently disabled and sign-in still works normally via the header.
# Client IDs are public by design — only the SECRET must stay server-side.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# --- Cloudinary ------------------------------------------------------------
# The cloud name appears in every delivery URL and is safe to expose.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# These two are server-only and are used to sign uploads. Never expose them.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Initial admin (used only by `npm run db:seed`) ------------------------
# The seed is idempotent: re-running it will not create a duplicate admin.
SEED_ADMIN_EMAIL="admin@mudkraft.com"
SEED_ADMIN_NAME="Mudkraft Studio"
# Use a strong password; change it after the first login.
SEED_ADMIN_PASSWORD=""
